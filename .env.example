# ─────────────────────────────────────────────────────────────
# Cardora — production environment template
# Copy to .env on the server and fill in REAL values.
# NEVER commit the real .env (it's in .gitignore).
# ─────────────────────────────────────────────────────────────

# MongoDB connection string (MongoDB Atlas free tier is fine to start).
# Format: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/cardora
MONGODB_URI=

# Session signing secret. MUST be 32+ characters and DIFFERENT from dev.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Port the Node process listens on (Caddy/nginx proxies 443 -> this).
PORT=8080

# ── Voice chat relay (optional but recommended for mobile players) ──
# Without TURN, players behind strict carrier NAT (4G/5G) may not hear
# each other. Free option: metered.ca. Self-host option: coturn.
TURN_URL=
TURN_USER=
TURN_PASS=

# ── Admin accounts (comma-separated usernames) ──
ADMIN_USERS=
